                if dist > 0.4 and Bypass.angularVelocity then
                    local lookDir = Vector3.new(delta.X, 0, delta.Z);
                    if lookDir.Magnitude > 0.08 then
                        local axis = root.CFrame.LookVector:Cross(lookDir.Unit);
                        local ang = math.asin(math.clamp(axis.Magnitude, -1, 1));
