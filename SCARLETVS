                    root.Velocity = Bypass.intendedVelocity;
                    if Bypass.angularVelocity then Bypass.angularVelocity.AngularVelocity = Vector3.zero; end;
                    return;
                end;
                Bypass.target = target;

                local targetPos = target.Position;
                local tHum = target.Parent and target.Parent:FindFirstChildOfClass("Humanoid");

                -- Velocity estimation with outlier clamp
                if lastTargetPos then
                    local raw = (targetPos - lastTargetPos) / dt;
                    local deltaV = raw - targetVel;
                    if deltaV.Magnitude > 150 then
                        raw = targetVel + deltaV.Unit * 150;
                    end;
                    local horiz = Vector3.new(raw.X, 0, raw.Z);
                    if horiz.Magnitude > 90 then
                        horiz = horiz.Unit * 90;
                        raw = Vector3.new(horiz.X, raw.Y, horiz.Z);
                    end;
                    table.insert(accelHistory, (raw - targetVel) / dt);
                    if #accelHistory > 5 then table.remove(accelHistory, 1); end;
                    table.insert(velHistory, raw);
                    if #velHistory > 10 then table.remove(velHistory, 1); end;
                    targetVel = raw;
                    smoothedVel = smoothedVel:Lerp(raw, 0.28);
                else
                    targetVel = target.AssemblyLinearVelocity;
                    smoothedVel = targetVel;
                end;
                lastTargetPos = targetPos;

                -- Airborne tracking
                local airborne = tHum and tHum.FloorMaterial == Enum.Material.Air;
                airborneTime = airborne and (airborneTime + dt) or 0;
                if airborne and airborneTime >= 0.08 then
                    table.insert(aerialHistory, targetVel);
                    if #aerialHistory > 6 then table.remove(aerialHistory, 1); end;
                elseif not airborne then
                    aerialHistory = {};
                end;

                local predVel = smoothedVel;
                if airborne and #aerialHistory > 0 then
                    local sum = Vector3.zero;
                    for _, v in ipairs(aerialHistory) do sum = sum + v; end;
                    local aerial = sum / #aerialHistory;
                    predVel = Vector3.new(aerial.X * 0.85, targetVel.Y, aerial.Z * 0.85);
                end;

                -- Acceleration contribution
                if #accelHistory > 0 then
                    local aSum = Vector3.zero;
                    for _, a in ipairs(accelHistory) do aSum = aSum + a; end;
                    predVel = predVel + (aSum / #accelHistory) * 0.35;
                end;

                -- Quick turn detection → extra lead
                local quickTurn = false;
                local horizV = Vector3.new(targetVel.X, 0, targetVel.Z);
                if horizV.Magnitude > 5 then
                    local dir = horizV.Unit;
                    if prevDir and prevDir:Dot(dir) < 0.45 then
                        quickTurn = true;
                        lastDirChange = tick();
                    end;
                    prevDir = dir;
                end;
                local turnBoost = (quickTurn or (tick() - lastDirChange < 0.14)) and 1.45 or 1;

                -- Prediction time: base + ping + distance factor
                local myPos = root.Position;
                local distNow = (targetPos - myPos).Magnitude;
                local predictT = math.clamp(0.16 + pingSec * 1.15 + math.min(distNow, 40) * 0.002, 0.14, 0.38);
                predictT = predictT * turnBoost;

                local predictPos = targetPos
                    + predVel * predictT
                    + target.CFrame.LookVector * (2.2 * turnBoost);
