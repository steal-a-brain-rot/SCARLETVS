        local function startBypass()
            if Bypass.conn then return; end;
            local hum0 = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid");
            if hum0 then
                Bypass.prevAutoRotate = hum0.AutoRotate;
                hum0.AutoRotate = false;
            end;

            -- -- Enhanced Bypass: acceleration + direction-change + ping lead (Clean BB+)
            local bFrame = 0;
            local bTarget = nil;
            local lastTargetPos = nil;
            local smoothedVel = Vector3.zero;
            local targetVel = Vector3.zero;
            local velHistory = {};
            local accelHistory = {};
            local aerialHistory = {};
            local prevDir = nil;
            local lastDirChange = 0;
            local airborneTime = 0;
            local pingSec = 0.08;
            task.spawn(function()
                while Bypass.enabled do
                    pcall(function()
